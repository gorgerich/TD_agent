{
  "name": "tihiydom-agents",
  "version": "0.1.0",
  "private": true,
  "description": "B2B-платформа «Тихий дом для агентов». Версии выровнены под прод-репозиторий frontend (Next 16, React 19, Prisma 5).",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "prisma generate && prisma db push --skip-generate --accept-data-loss && next build",
    "start": "next start -p 3001",
    "postinstall": "prisma generate",
    "lint": "eslint .",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name b2b_platform_init",
    "prisma:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@prisma/client": "^5.20.0",
    "@tailwindcss/postcss": "^4.3.0",
    "next": "^16.0.9",
    "postcss": "^8.5.15",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwindcss": "^4.3.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.0.5",
    "playwright": "^1.60.0",
    "prisma": "^5.20.0",
    "typescript": "^5"
  }
}
