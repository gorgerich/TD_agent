{
  "name": "tihiydom-agents",
  "version": "0.1.0",
  "private": true,
  "description": "B2B-платформа «Тихий дом для агентов». Версии выровнены под прод-репозиторий frontend (Next 16, React 19, Prisma 5).",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "prisma generate && next build",
    "start": "next start -p 3001",
    "postinstall": "prisma generate",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:unit": "node --import tsx --test tests/*.test.ts",
    "test:integration": "node scripts/run-integration-tests.mjs",
    "test:e2e": "node tests/e2e/smoke.mjs && node tests/e2e/m1-operations.mjs && node tests/e2e/m2-admin.mjs && node tests/e2e/m2-commercial.mjs && node tests/e2e/m3-fulfilment.mjs",
    "evidence:validate": "node scripts/validate-mission-evidence.mjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name b2b_platform_init",
    "prisma:deploy": "prisma migrate deploy",
    "ops:smoke-account": "tsx scripts/ops/smoke-account.ts",
    "ops:bootstrap-platform-super-admin": "tsx scripts/ops/bootstrap-platform-super-admin.ts",
    "ops:issue-platform-owner-recovery": "tsx scripts/ops/issue-platform-owner-recovery.ts",
    "ops:verify-migration-target": "tsx scripts/ops/verify-migration-target.ts",
    "ops:apply-m3-approved-policies": "tsx scripts/ops/apply-m3-approved-policies.ts",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@imgly/background-removal": "^1.5.8",
    "@phosphor-icons/react": "^2.1.10",
    "@prisma/client": "^5.20.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@vercel/blob": "^2.4.0",
    "next": "^16.0.9",
    "next-view-transitions": "^0.3.5",
    "postcss": "^8.5.15",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "qrcode.react": "^4.2.0",
    "tailwindcss": "^4.3.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@emnapi/core": "^1.11.2",
    "@emnapi/runtime": "^1.11.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.0.5",
    "playwright": "^1.60.0",
    "prisma": "^5.20.0",
    "shadcn": "^4.11.0",
    "tsx": "^4.22.4",
    "typescript": "^5"
  },
  "overrides": {
    "undici": "6.27.0"
  }
}
