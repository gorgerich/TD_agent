// NEW (B2B): хранит хэш одноразового кода для SMS-аутентификации агента.
// Мигрировать отдельно от основной схемы: npx prisma migrate dev --name add_otp_token
// Не хранить сам код — только sha256(code + salt).
model OtpToken {
  id        String   @id @default(cuid())
  phone     String
  codeHash  String // sha256(code + salt), NOT the raw code
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phone])
}
