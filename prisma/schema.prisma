// prisma/schema.prisma — ЦЕЛЕВАЯ схема: B2C (как в проде) + B2B-расширение «Тихий дом для агентов».
//
// Источник истины B2C-части: _reference/frontend/prisma/schema.prisma (read-only, не трогаем).
// Этот файл — кандидат на МЕРЖ в реальную схему. Применять ТОЛЬКО аддитивной миграцией
// против общей PostgreSQL-БД. Никаких изменений типов существующих полей.
//
// Допущение: модель агента — ВНУТРЕННЯЯ (агент = представитель ТД, оплата идёт ТД).
//   Решения собственника пока нет — все B2B-сущности помечены как требующие подтверждения.
//   Структура данных при этом почти модель-агностична; при маркетплейс-модели меняется
//   семантика (кто получатель Payment, кто формирует чек), но не форма таблиц.
//
// Команда миграции (dev): npx prisma migrate dev --name b2b_platform_init
// Для prod:               npx prisma migrate deploy   (предварительно бэкап БД)
// НИКОГДА не db push на prod.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Neon (Vercel) инжектит непулинговый URL как DATABASE_URL_UNPOOLED; используем его для миграций/db push.
  // Локально задаётся в .env (см. .env.example). Раньше назывался DIRECT_URL.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ============================================================
// B2C — существующие модели (НЕ МЕНЯТЬ типы; только добавлены relation-поля под B2B)
// ============================================================

model User {
  id                         Int          @id @default(autoincrement())
  email                      String?      @unique // B2C DB allows null emails; keep nullable so db push can apply B2B tables.
  name                       String?
  phone                      String?      @unique // NEW (B2B): для SMS-аутентификации агента; nullable — B2C-пользователи без телефона
  passwordHash               String? // NEW (B2B): хэш пароля агента для постоянного входа; nullable для B2C/demo пользователей
  platformRole               PlatformRole @default(USER)
  sessionVersion             Int          @default(0)
  platformMfaSecretEncrypted String?
  platformMfaEnabledAt       DateTime?
  orders                     Order[]

  agent                    Agent? // CHANGED: связь 1:1 с агентским профилем (опциональна — у клиента её нет)
  memberships              Membership[]
  platformAuditEvents      PlatformAuditEvent[]        @relation("PlatformAuditActor")
  platformActivations      PlatformAccountActivation[]
  approvedDocumentPolicies DocumentRequirementPolicy[] @relation("DocumentPolicyApprover")
  approvedSigningPolicies  ContractSigningPolicy[]     @relation("ContractSigningPolicyApprover")
}

model Order {
  id Int @id @default(autoincrement())

  // внешний id для фронта/платежки
  publicId String @unique

  userId Int
  user   User @relation(fields: [userId], references: [id])

  // CHANGED: НЕ мигрируем на enum — B2C-код читает строку. Допустимые значения теперь:
  // PENDING | PAID | CANCELED | SIGNED | PARTIALLY_PAID | IN_PROCESS | COMPLETED
  status        String  @default("PENDING")
  serviceType   String
  totalAmount   Int // копейки
  customerEmail String?
  paymentMethod String?
  paymentLink   String?
  meta          String

  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // CHANGED: поля B2B-сделки (все nullable — B2C-заказы их не заполняют)
  agentId         Int? // NEW
  agent           Agent?           @relation(fields: [agentId], references: [id]) // NEW
  meetingId       Int? // NEW
  meeting         Meeting?         @relation(fields: [meetingId], references: [id]) // NEW
  signedAt        DateTime? // NEW
  signatureMethod SignatureMethod? // NEW
  signature       Signature? // NEW
  commission      Commission? // NEW
  quote           Quote? // NEW
  depositPaid     Boolean          @default(false) // NEW
  cancelledAt     DateTime? // NEW
  cancelReason    String? // NEW

  @@index([publicId])
  @@index([agentId]) // NEW
  @@index([meetingId]) // NEW
}

model Payment {
  id                String @id @default(cuid())
  // CHANGED: для наличных провайдера нет → допускаем "cash"/"sbp" как значение
  provider          String
  providerPaymentId String @unique

  orderId Int
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  orderPublicId String

  amount          Int // К ОПЛАТЕ СЕЙЧАС (full/deposit), копейки
  currency        String  @default("RUB")
  status          String // pending|succeeded|canceled|failed
  confirmationUrl String?
  createRaw       String?
  webhookRaw      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // CHANGED: расширение под полевую оплату B2B
  method      PaymentMethod? // NEW: CASH | SBP_QR | CARD | BANK_TRANSFER
  isDeposit   Boolean        @default(false) // NEW
  fiscalUrl   String? // NEW: ссылка на чек ОФД
  fiscalSign  String? // NEW: фискальный признак (54-ФЗ)
  confirmedAt DateTime? // NEW: момент подтверждения (вебхук СБП / факт чека)
  meetingId   Int? // NEW
  meeting     Meeting?       @relation(fields: [meetingId], references: [id]) // NEW

  @@index([orderId])
  @@index([orderPublicId])
  @@index([meetingId]) // NEW
}

// ============================================================
// B2B — новые модели (все NEW). Требуют подтверждения модели собственником.
// ============================================================

model Agent {
  id                  Int         @id @default(autoincrement()) // NEW: Int — единообразно с User/Order
  userId              Int         @unique
  user                User        @relation(fields: [userId], references: [id])
  status              AgentStatus @default(PENDING)
  tierId              Int
  tier                AgentTier   @relation(fields: [tierId], references: [id])
  inn                 String? // ИНН ИП/самозанятого
  selfEmployed        Boolean     @default(true)
  onboardingCompleted Boolean     @default(false) // прошёл ли агент интерактивный онбординг
  notifyEnabled       Boolean     @default(true) // NEW (P0): тумблер in-app уведомлений

  leads        ClientLead[]
  meetings     Meeting[]
  orders       Order[]
  commissions  Commission[]
  payouts      Payout[]
  tasks        Task[] // NEW (P5)
  notes        CaseNote[] // NEW (P5)
  documents    Document[] // NEW (P0): реальные файлы кейса
  casePayments CasePayment[] // NEW (P0): оплаты по кейсам
  catalogItems AgentCatalogItem[] // NEW: собственные товары агента (свой каталог)
  ownedCases   Case[]             @relation("CaseOwner")
  membership   Membership?

  createdAt DateTime @default(now())

  @@index([userId])
}

// Mission 1 tenant foundation. Legacy organizations intentionally retain the
// existing Case tenant key (`agent:<id>`) so rollout cannot merge agent data.
model Organization {
  id        String             @id @default(cuid())
  name      String
  slug      String             @unique
  timezone  String             @default("Europe/Moscow")
  status    OrganizationStatus @default(ACTIVE)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  memberships              Membership[]
  invitations              OrganizationInvite[]
  cases                    Case[]
  tasks                    Task[]
  meetings                 Meeting[]
  auditEvents              OperationalAuditEvent[]
  savedViews               SavedOperationalView[]
  projectionReceipts       ProjectionReceipt[]
  quotes                   Quote[]
  catalogItems             AgentCatalogItem[]
  catalogRevisions         CatalogItemRevision[]
  caseParties              CaseParty[]
  documentTypeDefinitions  DocumentTypeDefinition[]
  documentPolicies         DocumentRequirementPolicy[]
  documentRequirements     CaseDocumentRequirement[]
  caseDocuments            CaseDocument[]
  documentVersions         CaseDocumentVersion[]
  documentAccessEvents     DocumentAccessEvent[]
  contracts                Contract[]
  contractVersions         ContractVersion[]
  paymentObligations       PaymentObligation[]
  paymentLedgerEntries     PaymentLedgerEntry[]
  paymentLedgerApprovals   PaymentLedgerApproval[]
  financialPolicies        FinancialControlPolicy[]
  paymentWebhookReceipts   PaymentWebhookReceipt[]
  contractSigningPolicies  ContractSigningPolicy[]
  casePartyRoleAssignments CasePartyRoleAssignment[]

  @@index([status, createdAt])
}

model Membership {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id])
  userId         Int
  user           User             @relation(fields: [userId], references: [id])
  agentId        Int?             @unique
  agent          Agent?           @relation(fields: [agentId], references: [id])
  role           MembershipRole   @default(AGENT)
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  assignedTasks             Task[]                     @relation("TaskAssignee")
  createdTasks              Task[]                     @relation("TaskCreator")
  ownedMeetings             Meeting[]                  @relation("MeetingOwner")
  auditEvents               OperationalAuditEvent[]    @relation("AuditActor")
  savedViews                SavedOperationalView[]     @relation("SavedViewOwner")
  invitationsCreated        OrganizationInvite[]       @relation("InvitationCreator")
  ownedQuotes               Quote[]                    @relation("QuoteOwner")
  publishedQuoteVersions    QuoteVersion[]             @relation("QuotePublisher")
  createdQuoteLinks         QuoteClientLink[]          @relation("QuoteLinkCreator")
  presentationSessions      QuotePresentationSession[] @relation("QuotePresentationOwner")
  createdCaseParties        CaseParty[]                @relation("CasePartyCreator")
  createdPartyRoles         CasePartyRoleAssignment[]  @relation("CasePartyRoleCreator")
  assignedRequirements      CaseDocumentRequirement[]  @relation("DocumentRequirementOwner")
  uploadedDocumentVersions  CaseDocumentVersion[]      @relation("DocumentVersionUploader")
  assignedDocumentReviews   CaseDocumentVersion[]      @relation("DocumentVersionAssignee")
  reviewedDocumentVersions  CaseDocumentVersion[]      @relation("DocumentVersionReviewer")
  documentAccessEvents      DocumentAccessEvent[]      @relation("DocumentAccessActor")
  createdContracts          Contract[]                 @relation("ContractCreator")
  issuedContractVersions    ContractVersion[]          @relation("ContractIssuer")
  signedContractVersions    ContractVersion[]          @relation("ContractSigner")
  createdPaymentObligations PaymentObligation[]        @relation("PaymentObligationCreator")
  paymentLedgerEntries      PaymentLedgerEntry[]       @relation("PaymentLedgerActor")
  paymentApprovalsRequested PaymentLedgerApproval[]    @relation("PaymentApprovalRequester")
  paymentApprovalsDecided   PaymentLedgerApproval[]    @relation("PaymentApprovalDecider")

  @@unique([organizationId, userId])
  @@index([organizationId, role, status])
}

model OrganizationInvite {
  id                    String         @id @default(cuid())
  organizationId        String
  organization          Organization   @relation(fields: [organizationId], references: [id])
  emailNormalized       String
  tokenHash             String         @unique
  role                  MembershipRole @default(AGENT)
  expiresAt             DateTime
  acceptedAt            DateTime?
  revokedAt             DateTime?
  createdByMembershipId String
  createdBy             Membership     @relation("InvitationCreator", fields: [createdByMembershipId], references: [id])
  createdAt             DateTime       @default(now())

  @@index([organizationId, emailNormalized])
  @@index([expiresAt])
}

// Собственный каталог агента: агент загружает фото товара, платформа вырезает фон
// (клиентский matte), агент задаёт название/категорию/цену и использует в смете.
model AgentCatalogItem {
  id                    String                @id @default(cuid())
  agentId               Int
  agent                 Agent                 @relation(fields: [agentId], references: [id], onDelete: Cascade)
  name                  String
  category              String // одна из CatalogCategory (строкой, чтобы не тянуть enum в БД)
  clientPrice           Int // цена для клиента, ₽
  costPrice             Int                   @default(0) // закупочная, ₽ (для маржи)
  description           String                @default("")
  imageData             String                @db.Text // data URL вырезанного товара на белом фоне (webp/png base64)
  organizationId        String?
  organization          Organization?         @relation(fields: [organizationId], references: [id])
  priceState            CommercialPriceState  @default(UNKNOWN)
  costState             CommercialCostState   @default(UNKNOWN)
  availability          CatalogAvailability   @default(AVAILABLE)
  scenarioCompatibility Json                  @default("[\"CREMATION_V1\",\"FAMILY_PLOT_BURIAL_V1\"]")
  currentVersion        Int                   @default(1)
  revisions             CatalogItemRevision[]
  quoteLineItems        QuoteLineItem[]       @relation("QuoteLineCatalogItem")
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @default(now()) @updatedAt

  @@index([agentId])
  @@index([organizationId, availability])
}

model CatalogItemRevision {
  id                    String               @id @default(cuid())
  catalogItemId         String
  catalogItem           AgentCatalogItem     @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)
  organizationId        String
  organization          Organization         @relation(fields: [organizationId], references: [id])
  version               Int
  name                  String
  description           String
  unit                  String               @default("шт.")
  priceState            CommercialPriceState
  clientUnitPrice       Int?
  costState             CommercialCostState
  unitCost              Int?
  currency              String               @default("RUB")
  availability          CatalogAvailability
  scenarioCompatibility Json
  vendorSource          String?
  vendorSourceVersion   String?
  quoteLineItems        QuoteLineItem[]      @relation("QuoteLineCatalogRevision")
  createdAt             DateTime             @default(now())

  @@unique([catalogItemId, version])
  @@index([organizationId, availability])
}

model AgentTier {
  id            Int     @id @default(autoincrement())
  name          String  @unique // Junior | Senior | Top
  commissionPct Decimal @db.Decimal(5, 2) // % от МАРЖИ (см. Блок 3.1), не от чека
  agents        Agent[]
}

model ClientLead {
  id            Int           @id @default(autoincrement())
  agentId       Int
  agent         Agent         @relation(fields: [agentId], references: [id])
  name          String
  phone         String
  context       String? // сведения об усопшем, бюджетные ожидания (ПДн — шифровать на уровне приложения)
  source        String // telegram | form | agent
  // NEW (P1): структурный интейк потребностей семьи (захват во время встречи)
  ceremonyType  String? // кремация | погребение | …
  budget        String? // бюджетная вилка
  religion      String? // конфессия/традиция
  needs         String? // особые пожелания (ПДн — шифровать через encryptField)
  // NEW (P0, MVP-домен): усопший и церемония — главный дедлайн кейса
  deceasedName  String? // ФИО усопшего (ПДн — encryptField)
  deceasedDate  DateTime? // дата смерти
  morgue        String? // морг / где находится
  ceremonyAt    DateTime? // дата и время церемонии (жёсткий дедлайн кейса)
  ceremonyPlace String? // кладбище / крематорий
  meetings      Meeting[]
  tasks         Task[] // NEW (P5)
  notes         CaseNote[] // NEW (P5)
  documents     Document[] // NEW (P0): реальные файлы кейса
  payments      CasePayment[] // NEW (P0): оплаты, фиксируемые агентом
  case          Case?
  createdAt     DateTime      @default(now())

  @@index([agentId])
}

model Meeting {
  id                Int                      @id @default(autoincrement())
  leadId            Int
  lead              ClientLead               @relation(fields: [leadId], references: [id])
  agentId           Int
  agent             Agent                    @relation(fields: [agentId], references: [id])
  status            MeetingStatus            @default(SCHEDULED)
  organizationId    String
  organization      Organization             @relation(fields: [organizationId], references: [id])
  caseId            String
  case              Case                     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  ownerMembershipId String
  ownerMembership   Membership               @relation("MeetingOwner", fields: [ownerMembershipId], references: [id])
  type              OperationalMeetingType   @default(CONSULTATION)
  operationalStatus OperationalMeetingStatus @default(TENTATIVE)
  attendees         Json                     @default("[]")
  channel           MeetingChannel           @default(IN_PERSON)
  location          String?
  durationMinutes   Int?
  timezone          String                   @default("Europe/Moscow")
  reminderAt        DateTime?
  outcome           String?
  outcomeRecordedAt DateTime?
  idempotencyKey    String
  version           Int                      @default(1)
  cobrowseCode      String?                  @unique // короткий код для «зеркала сметы» у клиента
  coViewedAt        DateTime? // NEW (P2): когда клиент впервые открыл /co
  coAgreedAt        DateTime? // NEW (P2): когда клиент нажал «Согласовать смету»

  orders   Order[]
  payments Payment[]
  quotes   Quote[]
  session  AgentSession?

  scheduledAt DateTime?
  startedAt   DateTime?
  endedAt     DateTime?

  @@unique([organizationId, idempotencyKey])
  @@index([agentId])
  @@index([leadId])
  @@index([organizationId, ownerMembershipId, operationalStatus])
  @@index([organizationId, scheduledAt])
  @@index([caseId])
}

model Quote {
  id                       Int                        @id @default(autoincrement())
  meetingId                Int
  meeting                  Meeting                    @relation(fields: [meetingId], references: [id])
  organizationId           String?
  organization             Organization?              @relation(fields: [organizationId], references: [id])
  caseId                   String?
  case                     Case?                      @relation("CommercialQuoteCase", fields: [caseId], references: [id])
  ownerMembershipId        String?
  ownerMembership          Membership?                @relation("QuoteOwner", fields: [ownerMembershipId], references: [id])
  scenario                 CaseScenario?
  status                   QuoteLifecycleStatus       @default(LEGACY_INCOMPLETE)
  currency                 String                     @default("RUB")
  activeDraftVersionId     Int?                       @unique
  activeDraftVersion       QuoteVersion?              @relation("ActiveQuoteDraft", fields: [activeDraftVersionId], references: [id])
  latestPublishedVersionId Int?                       @unique
  latestPublishedVersion   QuoteVersion?              @relation("LatestPublishedQuoteVersion", fields: [latestPublishedVersionId], references: [id])
  versions                 QuoteVersion[]             @relation("QuoteVersions")
  presentationSessions     QuotePresentationSession[]
  orderId                  Int?                       @unique
  order                    Order?                     @relation(fields: [orderId], references: [id])
  version                  Int                        @default(1)
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @default(now()) @updatedAt

  @@index([meetingId])
  @@index([organizationId, status, updatedAt])
  @@index([caseId])
  @@index([ownerMembershipId, status])
}

model QuoteVersion {
  id                      Int                   @id @default(autoincrement())
  quoteId                 Int
  quote                   Quote                 @relation("QuoteVersions", fields: [quoteId], references: [id])
  versionNumber           Int?
  state                   QuoteVersionState     @default(LEGACY_INCOMPLETE)
  payload                 String // canonical reproducible JSON snapshot
  subtotal                Int?
  discountTotal           Int?
  total                   Int // minor units (kopecks)
  totalState              CommercialPriceState  @default(UNKNOWN)
  currency                String                @default("RUB")
  snapshotChecksum        String?
  catalogSourceVersion    String?
  publishedByMembershipId String?
  publishedBy             Membership?           @relation("QuotePublisher", fields: [publishedByMembershipId], references: [id])
  publishedAt             DateTime?
  publishReason           String?
  publishChannel          String?
  validUntil              DateTime?
  idempotencyKey          String?
  correlationId           String?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @default(now()) @updatedAt
  lineItems               QuoteLineItem[]
  clientLinks             QuoteClientLink[]
  decisions               QuoteClientDecision[]
  activeDraftFor          Quote?                @relation("ActiveQuoteDraft")
  latestPublishedFor      Quote?                @relation("LatestPublishedQuoteVersion")
  publishedForCases       Case[]                @relation("PublishedQuoteForCase")
  contractVersions        ContractVersion[]

  @@unique([quoteId, versionNumber])
  @@unique([quoteId, idempotencyKey])
  @@index([quoteId])
  @@index([state, publishedAt])
  @@index([publishedByMembershipId])
}

model QuoteLineItem {
  id                    String               @id @default(cuid())
  quoteVersionId        Int
  quoteVersion          QuoteVersion         @relation(fields: [quoteVersionId], references: [id], onDelete: Cascade)
  stableKey             String
  position              Int
  type                  QuoteLineItemType
  catalogItemId         String?
  catalogItem           AgentCatalogItem?    @relation("QuoteLineCatalogItem", fields: [catalogItemId], references: [id])
  catalogRevisionId     String?
  catalogRevision       CatalogItemRevision? @relation("QuoteLineCatalogRevision", fields: [catalogRevisionId], references: [id])
  serviceCode           String?
  description           String
  quantity              Int                  @default(1)
  unit                  String               @default("шт.")
  priceState            CommercialPriceState
  clientUnitPrice       Int?
  costState             CommercialCostState
  unitCost              Int?
  discountAmount        Int                  @default(0)
  included              Boolean              @default(false)
  optional              Boolean              @default(false)
  relationKind          QuoteLineRelation    @default(STANDALONE)
  relationKey           String?
  source                String
  sourceVersion         String
  scenarioCompatibility Json
  createdAt             DateTime             @default(now())

  @@unique([quoteVersionId, stableKey])
  @@index([quoteVersionId, position])
  @@index([catalogItemId, catalogRevisionId])
}

model QuoteClientLink {
  id                    String       @id @default(cuid())
  quoteVersionId        Int
  quoteVersion          QuoteVersion @relation(fields: [quoteVersionId], references: [id], onDelete: Cascade)
  tokenHash             String       @unique
  expiresAt             DateTime
  revokedAt             DateTime?
  createdByMembershipId String
  createdBy             Membership   @relation("QuoteLinkCreator", fields: [createdByMembershipId], references: [id])
  createdAt             DateTime     @default(now())
  lastViewedAt          DateTime?

  @@index([quoteVersionId, expiresAt])
}

model QuoteClientDecision {
  id             String                  @id @default(cuid())
  quoteVersionId Int
  quoteVersion   QuoteVersion            @relation(fields: [quoteVersionId], references: [id])
  type           QuoteClientDecisionType
  comment        String?
  source         String
  actorType      String                  @default("client-link")
  idempotencyKey String
  correlationId  String
  createdAt      DateTime                @default(now())

  @@unique([quoteVersionId])
  @@index([quoteVersionId, idempotencyKey])
}

model QuotePresentationSession {
  id                String     @id @default(cuid())
  quoteId           Int
  quote             Quote      @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  ownerMembershipId String
  owner             Membership @relation("QuotePresentationOwner", fields: [ownerMembershipId], references: [id])
  state             Json
  startedAt         DateTime   @default(now())
  endedAt           DateTime?
  expiresAt         DateTime

  @@index([quoteId, expiresAt])
}

// Canonical Week 2 aggregate. ClientLead remains contact/intake storage; Case owns
// lifecycle, scenario, tenant identity and immutable transition history.
model Case {
  id                      String                    @id @default(cuid())
  publicRef               String                    @unique @default(cuid())
  leadId                  Int                       @unique
  lead                    ClientLead                @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tenantId                String
  organization            Organization              @relation(fields: [tenantId], references: [id])
  ownerId                 Int
  owner                   Agent                     @relation("CaseOwner", fields: [ownerId], references: [id])
  scenarioId              CaseScenario              @default(UNSELECTED)
  stage                   CaseStage                 @default(INTAKE)
  version                 Int                       @default(1)
  guardState              Json                      @default("{}")
  publishedQuoteVersionId Int?
  publishedQuoteVersion   QuoteVersion?             @relation("PublishedQuoteForCase", fields: [publishedQuoteVersionId], references: [id])
  commercialQuotes        Quote[]                   @relation("CommercialQuoteCase")
  closedAt                DateTime?
  events                  CaseEvent[]
  tasks                   Task[]
  meetings                Meeting[]
  parties                 CaseParty[]
  documentRequirements    CaseDocumentRequirement[]
  caseDocuments           CaseDocument[]
  documentVersions        CaseDocumentVersion[]
  documentAccessEvents    DocumentAccessEvent[]
  contract                Contract?
  contractVersions        ContractVersion[]
  paymentObligations      PaymentObligation[]
  paymentLedgerEntries    PaymentLedgerEntry[]
  paymentWebhookReceipts  PaymentWebhookReceipt[]
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt

  @@index([tenantId, ownerId])
  @@index([tenantId, stage])
  @@index([publishedQuoteVersionId])
}

// Append-only audit/domain event. There are intentionally no update/delete routes.
model CaseEvent {
  id             String    @id @default(cuid())
  caseId         String
  case           Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  tenantId       String
  actorId        Int
  actorType      String    @default("agent")
  eventType      String
  eventVersion   Int       @default(1)
  idempotencyKey String
  correlationId  String
  causationId    String?
  fromStage      CaseStage
  toStage        CaseStage
  before         Json
  after          Json
  payload        Json
  result         Json
  createdAt      DateTime  @default(now())

  @@unique([tenantId, idempotencyKey])
  @@index([caseId, createdAt])
  @@index([tenantId, eventType, createdAt])
}

model Signature {
  id       Int             @id @default(autoincrement())
  orderId  Int             @unique
  order    Order           @relation(fields: [orderId], references: [id])
  method   SignatureMethod
  docHash  String // sha256 подписанного PDF
  smsHash  String? // хэш SMS-кода (НЕ сам код)
  signedAt DateTime        @default(now())
}

model Commission {
  id       Int              @id @default(autoincrement())
  agentId  Int
  agent    Agent            @relation(fields: [agentId], references: [id])
  orderId  Int              @unique
  order    Order            @relation(fields: [orderId], references: [id])
  amount   Int // копейки
  status   CommissionStatus @default(ACCRUED)
  payoutId Int?
  payout   Payout?          @relation(fields: [payoutId], references: [id])

  @@index([agentId])
}

model Payout {
  id          Int          @id @default(autoincrement())
  agentId     Int
  agent       Agent        @relation(fields: [agentId], references: [id])
  status      PayoutStatus @default(PENDING)
  amount      Int // копейки
  commissions Commission[]
  paidAt      DateTime?

  @@index([agentId])
}

model AgentSession {
  id        Int      @id @default(autoincrement())
  meetingId Int      @unique
  meeting   Meeting  @relation(fields: [meetingId], references: [id])
  state     String // текущая смета co-browse (JSON-строкой; шифровать на уровне приложения, ФЗ-152)
  expiresAt DateTime // авто-удаление после встречи (cron, см. Блок 2.7)
  createdAt DateTime @default(now())
}

// ============================================================
// P5 — Tasks + Notes (аддитивно, без изменения существующих полей)
// ============================================================

model Task {
  id                    Int          @id @default(autoincrement())
  leadId                Int
  lead                  ClientLead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  agentId               Int
  agent                 Agent        @relation(fields: [agentId], references: [id])
  organizationId        String
  organization          Organization @relation(fields: [organizationId], references: [id])
  caseId                String
  case                  Case         @relation(fields: [caseId], references: [id], onDelete: Cascade)
  assigneeMembershipId  String?
  assignee              Membership?  @relation("TaskAssignee", fields: [assigneeMembershipId], references: [id])
  createdByMembershipId String
  createdBy             Membership   @relation("TaskCreator", fields: [createdByMembershipId], references: [id])
  type                  TaskType     @default(MANUAL)
  priority              TaskPriority @default(NORMAL)
  status                TaskStatus   @default(OPEN)
  sourceEventId         String?
  expectedOutcome       String?
  outcome               String?
  waitingReason         String?
  supersededById        Int?
  supersededBy          Task?        @relation("TaskSupersession", fields: [supersededById], references: [id])
  supersedes            Task[]       @relation("TaskSupersession")
  idempotencyKey        String
  version               Int          @default(1)
  title                 String
  dueAt                 DateTime? // null = без срока
  completedAt           DateTime? // null = открыта; DateTime = выполнена
  cancelledAt           DateTime?
  createdAt             DateTime     @default(now())

  @@unique([organizationId, idempotencyKey])
  @@unique([organizationId, sourceEventId, type])
  @@index([leadId])
  @@index([agentId])
  @@index([agentId, completedAt])
  @@index([agentId, dueAt])
  @@index([organizationId, assigneeMembershipId, status, dueAt])
  @@index([organizationId, priority, dueAt])
  @@index([caseId])
}

// Append-only operational audit. Application exposes create/read only.
model OperationalAuditEvent {
  id                String       @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id])
  actorMembershipId String?
  actor             Membership?  @relation("AuditActor", fields: [actorMembershipId], references: [id])
  actorType         String       @default("member")
  entityType        String
  entityId          String
  action            String
  before            Json
  after             Json
  reason            String?
  correlationId     String
  causationId       String?
  idempotencyKey    String
  result            Json
  createdAt         DateTime     @default(now())

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, entityType, entityId, createdAt])
  @@index([organizationId, actorMembershipId, createdAt])
}

// Global platform administration audit. It is intentionally not tenant-scoped:
// platform events must never be mixed into OperationalAuditEvent.
model PlatformAuditEvent {
  id          String   @id @default(cuid())
  actorUserId Int
  actor       User     @relation("PlatformAuditActor", fields: [actorUserId], references: [id])
  action      String
  targetType  String
  targetId    String?
  metadata    Json
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([actorUserId, createdAt])
  @@index([targetType, targetId, createdAt])
}

// One-time first-access credential activation for a trusted platform user.
// Raw bearer tokens never enter PostgreSQL; only SHA-256 digests are stored.
model PlatformAccountActivation {
  id                 String                           @id @default(cuid())
  userId             Int
  user               User                             @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose            PlatformAccountActivationPurpose @default(FIRST_ACCESS)
  tokenHash          String                           @unique
  mfaSecretEncrypted String
  expiresAt          DateTime
  consumedAt         DateTime?
  revokedAt          DateTime?
  createdAt          DateTime                         @default(now())

  @@index([userId, createdAt])
  @@index([userId, purpose, createdAt])
  @@index([expiresAt])
}

enum PlatformAccountActivationPurpose {
  FIRST_ACCESS
  OWNER_RECOVERY
}

// Shared limiter for high-value platform authentication endpoints. Keys are
// one-way hashes; no IP address, token or credential is stored.
model SecurityRateLimitBucket {
  keyHash   String   @id
  count     Int
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

model SavedOperationalView {
  id                String         @id @default(cuid())
  organizationId    String
  organization      Organization   @relation(fields: [organizationId], references: [id])
  ownerMembershipId String
  owner             Membership     @relation("SavedViewOwner", fields: [ownerMembershipId], references: [id])
  name              String
  scope             SavedViewScope @default(MY)
  query             Json
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@unique([ownerMembershipId, name])
  @@index([organizationId, scope])
}

model ProjectionReceipt {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  projector      String
  sourceEventId  String
  result         Json
  createdAt      DateTime     @default(now())

  @@unique([organizationId, projector, sourceEventId])
  @@index([organizationId, createdAt])
}

model CaseNote {
  id        Int        @id @default(autoincrement())
  leadId    Int
  lead      ClientLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  agentId   Int
  agent     Agent      @relation(fields: [agentId], references: [id])
  body      String // ПДн — шифровать на уровне app (encryptField), как ClientLead.context
  createdAt DateTime   @default(now())

  @@index([leadId])
  @@index([agentId])
}

// NEW (P0): оплаты по кейсу, фиксируемые агентом (аванс/остаток).
// Намеренно отдельно от B2C Order/Payment — их не трогаем.
model CasePayment {
  id            Int        @id @default(autoincrement())
  leadId        Int
  lead          ClientLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  agentId       Int
  agent         Agent      @relation(fields: [agentId], references: [id])
  amountKopecks Int
  kind          String // "аванс" | "остаток" | "полная"
  method        String // "наличные" | "карта" | "счёт"
  note          String?
  paidAt        DateTime   @default(now())

  @@index([leadId])
  @@index([agentId])
}

// NEW (P0): реальные документы кейса. Файл лежит в Vercel Blob, в БД — метаданные.
model Document {
  id        Int        @id @default(autoincrement())
  leadId    Int
  lead      ClientLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  agentId   Int
  agent     Agent      @relation(fields: [agentId], references: [id])
  name      String // имя файла как загрузил агент
  category  String // "Свидетельство о смерти" | "Паспорт" | "Договор" | "Доверенность" | "Прочее"
  url       String // Vercel Blob URL
  pathname  String // ключ в Blob (для удаления)
  mimeType  String
  size      Int // байты
  createdAt DateTime   @default(now())

  @@index([leadId])
  @@index([agentId])
}

// M3 canonical family/contact aggregate. Contact fields are encrypted by the
// application adapter; role assignments are separate so one party can hold
// several effective roles without identity-by-name joins.
model CaseParty {
  id                    String                    @id @default(cuid())
  organizationId        String
  organization          Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  caseId                String
  case                  Case                      @relation(fields: [caseId], references: [id], onDelete: Restrict)
  nameEncrypted         String
  phoneEncrypted        String?
  emailEncrypted        String?
  preferredChannel      M3CommunicationChannel    @default(NONE)
  consentStatus         M3ConsentStatus           @default(UNKNOWN)
  consentSource         String?
  consentAt             DateTime?
  visibilityPolicy      M3PartyVisibility         @default(CASE_TEAM)
  createdByMembershipId String
  createdBy             Membership                @relation("CasePartyCreator", fields: [createdByMembershipId], references: [id], onDelete: Restrict)
  roles                 CasePartyRoleAssignment[]
  paymentObligations    PaymentObligation[]
  paymentLedgerEntries  PaymentLedgerEntry[]
  contractVersions      ContractVersion[]
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  @@index([organizationId, caseId])
  @@index([caseId, consentStatus])
}

model CasePartyRoleAssignment {
  id                    String        @id @default(cuid())
  organizationId        String
  organization          Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  casePartyId           String
  caseParty             CaseParty     @relation(fields: [casePartyId], references: [id], onDelete: Restrict)
  role                  CasePartyRole
  validFrom             DateTime      @default(now())
  validUntil            DateTime?
  createdByMembershipId String
  createdBy             Membership    @relation("CasePartyRoleCreator", fields: [createdByMembershipId], references: [id], onDelete: Restrict)
  createdAt             DateTime      @default(now())

  @@unique([casePartyId, role, validFrom])
  @@index([organizationId, role, validUntil])
}

model DocumentTypeDefinition {
  id               String         @id @default(cuid())
  organizationId   String
  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  code             String
  version          Int
  name             String
  description      String?
  allowedMimeTypes Json
  maxBytes         Int
  status           M3PolicyStatus @default(DRAFT_POLICY)
  source           String
  documents        CaseDocument[]
  createdAt        DateTime       @default(now())

  @@unique([organizationId, code, version])
  @@index([organizationId, status, code])
}

model DocumentRequirementPolicy {
  id               String                    @id @default(cuid())
  organizationId   String
  organization     Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  scenario         CaseScenario
  version          Int
  status           M3PolicyStatus            @default(DRAFT_POLICY)
  source           String
  approvedByUserId Int?
  approvedBy       User?                     @relation("DocumentPolicyApprover", fields: [approvedByUserId], references: [id], onDelete: Restrict)
  approvedAt       DateTime?
  effectiveFrom    DateTime?
  retiredAt        DateTime?
  rules            DocumentRequirementRule[]
  requirements     CaseDocumentRequirement[]
  createdAt        DateTime                  @default(now())

  @@unique([organizationId, scenario, version])
  @@index([organizationId, scenario, status, effectiveFrom])
}

model DocumentRequirementRule {
  id                        String                    @id @default(cuid())
  policyId                  String
  policy                    DocumentRequirementPolicy @relation(fields: [policyId], references: [id], onDelete: Restrict)
  stableKey                 String
  kind                      M3RequirementKind
  conditionKey              String?
  conditionExplanation      String?
  dueOffsetHours            Int?
  ownerRole                 MembershipRole
  blockingStage             CaseStage
  acceptedDocumentTypeCodes Json
  acceptedDocumentTypeVersionIds Json
  reviewChecklist           Json
  source                    String
  requirements              CaseDocumentRequirement[]
  createdAt                 DateTime                  @default(now())

  @@unique([policyId, stableKey])
  @@index([policyId, blockingStage])
}

model CaseDocumentRequirement {
  id                        String                    @id @default(cuid())
  organizationId            String
  organization              Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  caseId                    String
  case                      Case                      @relation(fields: [caseId], references: [id], onDelete: Restrict)
  policyId                  String
  policy                    DocumentRequirementPolicy @relation(fields: [policyId], references: [id], onDelete: Restrict)
  ruleId                    String
  rule                      DocumentRequirementRule   @relation(fields: [ruleId], references: [id], onDelete: Restrict)
  policyVersion             Int
  stableKey                 String
  kind                      M3RequirementKind
  conditionExplanation      String?
  dueAt                     DateTime?
  ownerMembershipId         String?
  owner                     Membership?               @relation("DocumentRequirementOwner", fields: [ownerMembershipId], references: [id], onDelete: Restrict)
  ownerRole                 MembershipRole
  blockingStage             CaseStage
  acceptedDocumentTypeCodes Json
  acceptedDocumentTypeVersionIds Json
  reviewChecklist           Json
  isApplicable              Boolean                   @default(true)
  applicabilityEvaluatedAt  DateTime                  @default(now())
  satisfactionStatus        M3RequirementSatisfaction @default(NOT_SATISFIED)
  satisfiedByVersionId      String?                   @unique
  satisfiedByVersion        CaseDocumentVersion?      @relation("RequirementSatisfiedBy", fields: [satisfiedByVersionId], references: [id], onDelete: Restrict)
  sourceRule                String
  document                  CaseDocument?
  documentVersions          CaseDocumentVersion[]
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt

  @@unique([caseId, ruleId])
  @@unique([caseId, stableKey, policyVersion])
  @@index([organizationId, satisfactionStatus, dueAt])
  @@index([caseId, blockingStage, isApplicable])
}

model CaseDocument {
  id             String                   @id @default(cuid())
  organizationId String
  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  caseId         String
  case           Case                     @relation(fields: [caseId], references: [id], onDelete: Restrict)
  requirementId  String?                  @unique
  requirement    CaseDocumentRequirement? @relation(fields: [requirementId], references: [id], onDelete: Restrict)
  documentTypeId String
  documentType   DocumentTypeDefinition   @relation(fields: [documentTypeId], references: [id], onDelete: Restrict)
  status         DocumentLifecycleStatus  @default(REQUIRED)
  versions       CaseDocumentVersion[]
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  @@index([organizationId, caseId, status])
  @@index([documentTypeId])
}

model CaseDocumentVersion {
  id                           String                   @id @default(cuid())
  documentId                   String
  document                     CaseDocument             @relation(fields: [documentId], references: [id], onDelete: Restrict)
  versionNumber                Int
  organizationId               String
  organization                 Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  caseId                       String
  case                         Case                     @relation(fields: [caseId], references: [id], onDelete: Restrict)
  requirementId                String?
  requirement                  CaseDocumentRequirement? @relation(fields: [requirementId], references: [id], onDelete: Restrict)
  fileChecksum                 String
  storageKey                   String                   @unique
  storageEtag                  String
  originalFilenameEncrypted    String
  mimeType                     String
  size                         Int
  uploaderMembershipId         String
  uploader                     Membership               @relation("DocumentVersionUploader", fields: [uploaderMembershipId], references: [id], onDelete: Restrict)
  source                       String
  status                       DocumentLifecycleStatus  @default(QUARANTINED)
  scanStatus                   DocumentScanStatus       @default(PENDING)
  scanProvider                 String?
  scanResultCode               String?
  assignedReviewerMembershipId String?
  assignedReviewer             Membership?              @relation("DocumentVersionAssignee", fields: [assignedReviewerMembershipId], references: [id], onDelete: Restrict)
  reviewedByMembershipId       String?
  reviewedBy                   Membership?              @relation("DocumentVersionReviewer", fields: [reviewedByMembershipId], references: [id], onDelete: Restrict)
  reviewedAt                   DateTime?
  reviewChecklist              Json?
  rejectionReason              String?
  expiresAt                    DateTime?
  supersedesVersionId          String?                  @unique
  supersedesVersion            CaseDocumentVersion?     @relation("DocumentVersionSupersession", fields: [supersedesVersionId], references: [id], onDelete: Restrict)
  supersededBy                 CaseDocumentVersion?     @relation("DocumentVersionSupersession")
  satisfiesRequirement         CaseDocumentRequirement? @relation("RequirementSatisfiedBy")
  accessEvents                 DocumentAccessEvent[]
  createdAt                    DateTime                 @default(now())

  @@unique([documentId, versionNumber])
  @@index([organizationId, status, createdAt])
  @@index([caseId, requirementId])
  @@index([reviewedByMembershipId, status])
  @@index([assignedReviewerMembershipId, status])
}

model DocumentAccessEvent {
  id                String               @id @default(cuid())
  organizationId    String
  organization      Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  caseId            String
  case              Case                 @relation(fields: [caseId], references: [id], onDelete: Restrict)
  documentVersionId String
  documentVersion   CaseDocumentVersion  @relation(fields: [documentVersionId], references: [id], onDelete: Restrict)
  actorMembershipId String
  actor             Membership           @relation("DocumentAccessActor", fields: [actorMembershipId], references: [id], onDelete: Restrict)
  action            DocumentAccessAction
  purpose           String
  correlationId     String
  createdAt         DateTime             @default(now())

  @@unique([organizationId, correlationId])
  @@index([organizationId, caseId, createdAt])
  @@index([documentVersionId, createdAt])
}

// Legal-approved proof boundary. A caller-provided label is never enough to
// turn an issued contract into a signed obligation.
model ContractSigningPolicy {
  id                   String            @id @default(cuid())
  organizationId       String
  organization         Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  version              String
  status               M3PolicyStatus    @default(DRAFT_POLICY)
  allowedEvidenceTypes Json
  source               String
  approvedByUserId     Int?
  approvedBy           User?             @relation("ContractSigningPolicyApprover", fields: [approvedByUserId], references: [id], onDelete: Restrict)
  approvedAt           DateTime?
  effectiveFrom        DateTime?
  retiredAt            DateTime?
  contractVersions     ContractVersion[]
  createdAt            DateTime          @default(now())

  @@unique([organizationId, version])
  @@index([organizationId, status, effectiveFrom])
}

model Contract {
  id                    String            @id @default(cuid())
  organizationId        String
  organization          Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  caseId                String            @unique
  case                  Case              @relation(fields: [caseId], references: [id], onDelete: Restrict)
  createdByMembershipId String
  createdBy             Membership        @relation("ContractCreator", fields: [createdByMembershipId], references: [id], onDelete: Restrict)
  versions              ContractVersion[]
  createdAt             DateTime          @default(now())

  @@index([organizationId, createdAt])
}

model ContractVersion {
  id                     String                  @id @default(cuid())
  contractId             String
  contract               Contract                @relation(fields: [contractId], references: [id], onDelete: Restrict)
  organizationId         String
  organization           Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  caseId                 String
  case                   Case                    @relation(fields: [caseId], references: [id], onDelete: Restrict)
  quoteVersionId         Int
  quoteVersion           QuoteVersion            @relation(fields: [quoteVersionId], references: [id], onDelete: Restrict)
  versionNumber          Int
  status                 ContractLifecycleStatus @default(DRAFT)
  partiesSnapshot        Json
  payerPartyId           String?
  payerParty             CaseParty?              @relation(fields: [payerPartyId], references: [id], onDelete: Restrict)
  currency               String                  @default("RUB")
  totalObligationKopecks Int
  paymentTerms           Json
  issuedByMembershipId   String
  issuedBy               Membership              @relation("ContractIssuer", fields: [issuedByMembershipId], references: [id], onDelete: Restrict)
  issuedAt               DateTime?
  signedByMembershipId   String?
  signedBy               Membership?             @relation("ContractSigner", fields: [signedByMembershipId], references: [id], onDelete: Restrict)
  signedAt               DateTime?
  signatureEvidence      Json?
  signaturePolicyId      String?
  signaturePolicy        ContractSigningPolicy?  @relation(fields: [signaturePolicyId], references: [id], onDelete: Restrict)
  signaturePolicyVersion String?
  checksum               String
  validUntil             DateTime?
  supersedesVersionId    String?                 @unique
  supersedesVersion      ContractVersion?        @relation("ContractVersionSupersession", fields: [supersedesVersionId], references: [id], onDelete: Restrict)
  supersededBy           ContractVersion?        @relation("ContractVersionSupersession")
  idempotencyKey         String
  correlationId          String
  obligation             PaymentObligation?
  createdAt              DateTime                @default(now())

  @@unique([contractId, versionNumber])
  @@unique([contractId, quoteVersionId])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, caseId, status])
  @@index([quoteVersionId])
  @@index([signaturePolicyId])
}

model PaymentObligation {
  id                    String               @id @default(cuid())
  organizationId        String
  organization          Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  caseId                String
  case                  Case                 @relation(fields: [caseId], references: [id], onDelete: Restrict)
  contractVersionId     String               @unique
  contractVersion       ContractVersion      @relation(fields: [contractVersionId], references: [id], onDelete: Restrict)
  payerPartyId          String?
  payerParty            CaseParty?           @relation(fields: [payerPartyId], references: [id], onDelete: Restrict)
  amountKopecks         Int
  currency              String               @default("RUB")
  createdByMembershipId String
  createdBy             Membership           @relation("PaymentObligationCreator", fields: [createdByMembershipId], references: [id], onDelete: Restrict)
  idempotencyKey        String
  correlationId         String
  ledgerEntries         PaymentLedgerEntry[]
  createdAt             DateTime             @default(now())

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, caseId])
}

model PaymentLedgerEntry {
  id                    String                 @id @default(cuid())
  organizationId        String
  organization          Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  caseId                String
  case                  Case                   @relation(fields: [caseId], references: [id], onDelete: Restrict)
  obligationId          String
  obligation            PaymentObligation      @relation(fields: [obligationId], references: [id], onDelete: Restrict)
  payerPartyId          String?
  payerParty            CaseParty?             @relation(fields: [payerPartyId], references: [id], onDelete: Restrict)
  type                  PaymentLedgerEntryType
  direction             LedgerDirection
  amountKopecks         Int
  currency              String
  occurredAt            DateTime
  method                PaymentMethod?
  source                String
  externalTransactionId String?
  evidenceReference     String
  actorMembershipId     String?
  actor                 Membership?            @relation("PaymentLedgerActor", fields: [actorMembershipId], references: [id], onDelete: Restrict)
  actorType             String                 @default("member")
  idempotencyKey        String
  correlationId         String
  approvalRequired      Boolean                @default(false)
  relatedEntryId        String?
  relatedEntry          PaymentLedgerEntry?    @relation("LedgerEntryRelation", fields: [relatedEntryId], references: [id], onDelete: Restrict)
  relatedEntries        PaymentLedgerEntry[]   @relation("LedgerEntryRelation")
  approval              PaymentLedgerApproval?
  webhookReceipt        PaymentWebhookReceipt?
  createdAt             DateTime               @default(now())

  @@unique([organizationId, idempotencyKey])
  @@unique([organizationId, source, externalTransactionId])
  @@index([organizationId, caseId, createdAt])
  @@index([obligationId, createdAt])
  @@index([relatedEntryId])
}

model PaymentLedgerApproval {
  id                      String                  @id @default(cuid())
  organizationId          String
  organization            Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  ledgerEntryId           String                  @unique
  ledgerEntry             PaymentLedgerEntry      @relation(fields: [ledgerEntryId], references: [id], onDelete: Restrict)
  requestedByMembershipId String
  requestedBy             Membership              @relation("PaymentApprovalRequester", fields: [requestedByMembershipId], references: [id], onDelete: Restrict)
  decidedByMembershipId   String?
  decidedBy               Membership?             @relation("PaymentApprovalDecider", fields: [decidedByMembershipId], references: [id], onDelete: Restrict)
  decision                LedgerApprovalDecision?
  decidedAt               DateTime?
  policyVersion           Int
  requestReason           String
  decisionReason          String?
  idempotencyKey          String
  correlationId           String
  createdAt               DateTime                @default(now())

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, decision, createdAt])
}

model FinancialControlPolicy {
  id                         String         @id @default(cuid())
  organizationId             String
  organization               Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  version                    Int
  status                     M3PolicyStatus @default(DRAFT_POLICY)
  correctionThresholdKopecks Int?
  source                     String
  approvedAt                 DateTime?
  createdAt                  DateTime       @default(now())

  @@unique([organizationId, version])
  @@index([organizationId, status])
}

model PaymentWebhookReceipt {
  id                String              @id @default(cuid())
  organizationId    String
  organization      Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  caseId            String
  case              Case                @relation(fields: [caseId], references: [id], onDelete: Restrict)
  provider          String
  externalEventId   String
  eventVersion      String
  payloadHash       String
  signatureVerified Boolean
  rejectedReason    String?
  ledgerEntryId     String?             @unique
  ledgerEntry       PaymentLedgerEntry? @relation(fields: [ledgerEntryId], references: [id], onDelete: Restrict)
  receivedAt        DateTime            @default(now())

  @@unique([organizationId, provider, externalEventId])
  @@index([organizationId, caseId, receivedAt])
}

