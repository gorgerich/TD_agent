# Общая БД с B2C (PostgreSQL). Значения взять из прод-окружения tihiydom.
DATABASE_URL="postgresql://USER:PASS@HOST:5432/DB?schema=public"
DIRECT_URL="postgresql://USER:PASS@HOST:5432/DB?schema=public"

# Шифрование co-browse state и ПДн (ФЗ-152). 32-байтный ключ base64.
APP_ENCRYPTION_KEY=""

# SMS-провайдер для ПЭП-подписания (SMS Aero / SMS.ru) — заполнить на этапе подписания.
SMS_PROVIDER_API_KEY=""

# Эквайер СБП (вебхуки о зачислении) — заполнить после выбора банка.
SBP_WEBHOOK_SECRET=""
